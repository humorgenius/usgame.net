---
/**
 * 站点根路径 / —— 这里不是内容页，是一个"重定向存根"。
 *
 * 2026-09-27 站主拍板：输入 usgame.net 应该直接进英文版主页，去掉原来的中英双语选择页。
 * 中文读者不受影响 —— 英文站页头就有「中文」切换，404 页也给了中文入口，
 * 本页还留了一个中文兜底链接。
 *
 * 为什么不用真 301：GitHub Pages 是纯静态托管，没有服务端，发不出 301 响应。
 * 静态站上最接近 301 的三件事都在这儿：
 *   1) <meta http-equiv="refresh" content="0; url=/en/"> —— 0 秒刷新，搜索引擎按重定向处理
 *   2) <link rel="canonical" href="https://usgame.net/en/"> —— 声明规范地址，避免 / 被当成重复页
 *   3) 内联 JS location.replace() —— 浏览器直接换页，且不往浏览历史里多塞一条记录
 * 另外留一个可见链接兜底：禁用 JS、或刷新被浏览器拦下时还能手动走。
 *
 * 刻意不加 noindex —— 加了会打断重定向信号的传递，得不偿失。
 * 本页已从 sitemap 排除（见 astro.config.mjs 的 filter）；/en/ 与 /zh/ 都在 sitemap 里。
 * og:url 指向 /en/ —— 把 usgame.net 分享出去时，抓到的是英文站那张卡。
 */
const TARGET = "/en/";
const TARGET_ABS = "https://usgame.net/en/";
const TITLE = "USGAME — GTA6 news, guides and intel";
const DESC = "An independent GTA6 resource: news, guides, character dossiers and system breakdowns for Grand Theft Auto VI.";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={DESC} />

  {/* 三条重定向信号，尽量往前放 —— 越早发出越好 */}
  <meta http-equiv="refresh" content={`0; url=${TARGET}`} />
  <link rel="canonical" href={TARGET_ABS} />
  <script is:inline>location.replace("/en/");</script>

  {/* 图标与清单：这一页跟站内其它页一样要能被收藏、能加到主屏 */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0B0710" />
  <meta name="apple-mobile-web-app-title" content="USGAME-GTA6" />

  {/* 分享卡：给的是英文站的信息（og:url 与 canonical 一致）。
      跳转本身拦不住社交平台的抓取器，所以这几行是有实际作用的。 */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="USGAME" />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESC} />
  <meta property="og:url" content={TARGET_ABS} />
  <meta property="og:image" content="https://usgame.net/assets/img/og-default-en.jpg" />
  <meta property="og:image:alt" content={TITLE} />
  <meta property="og:locale" content="en" />
  <meta property="og:locale:alternate" content="zh_Hans" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={TITLE} />
  <meta name="twitter:description" content={DESC} />

  {/* 站名结构化数据：Google 搜索结果里的"站点名称"取自这里，
       必须和内容页 Base.astro 那套用同一组 @id，否则会被当成两个实体。 */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "WebSite", "@id": "https://usgame.net/#website", url: "https://usgame.net/",
        name: "USGAME", inLanguage: ["en", "zh-Hans"], publisher: { "@id": "https://usgame.net/#org" } },
      { "@type": "Organization", "@id": "https://usgame.net/#org", name: "USGAME",
        url: "https://usgame.net/", logo: "https://usgame.net/icon-512.png" },
    ],
  })} />

  <style>
    /* 这一页正常情况下一闪即过（0 秒刷新 + JS 换页），所以样式只做一件事：
       万一它被看见，得看得出属于本站，而不是一个坏掉的空白页。 */
    :root{
      --bg:#0B0710; --ink:#F6F0F7; --muted:#A294B0; --mag:#FF2D95;
      --line:rgba(255,45,149,.16); --line-hi:rgba(255,45,149,.44);
      --font-b:"Inter","Segoe UI","Microsoft YaHei",system-ui,sans-serif;
      --font-d:Anton,Impact,"Arial Black",Bahnschrift,sans-serif;
    }
    *,*::before,*::after{box-sizing:border-box}
    html,body{margin:0}
    body{background:var(--bg);color:var(--ink);font-family:var(--font-b);
         -webkit-font-smoothing:antialiased;min-height:100vh;
         display:flex;flex-direction:column;justify-content:center}
    /* 全页单一左轴：品牌、正句、兜底链接、页脚都从同一条 x 起 */
    .wrap{width:100%;max-width:44rem;margin:0 auto;padding:0 26px}
    .brand{display:flex;align-items:baseline;gap:12px;margin:0;
           font-family:var(--font-d);text-transform:uppercase;
           font-size:clamp(1.9rem,6vw,2.6rem);letter-spacing:.02em;line-height:1}
    .brand .bdg{font-family:var(--font-b);font-size:12px;font-weight:700;
                letter-spacing:.16em;color:var(--mag);border:1px solid var(--line-hi);
                border-radius:999px;padding:4px 10px 3px;transform:translateY(-4px)}
    .go{margin:20px 0 0;font-size:1rem;line-height:1.6;color:var(--ink)}
    .alt{margin:10px 0 0;font-size:.95rem;line-height:1.7;color:var(--muted)}
    .alt a{color:var(--mag);text-decoration:none;border-bottom:1px solid var(--line-hi)}
    .alt a:hover,.alt a:focus-visible{border-bottom-color:var(--mag)}
    .foot{margin:30px 0 0;padding-top:16px;border-top:1px solid var(--line);
          font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:#5E5468}
  </style>
</head>
<body>
  <main class="wrap">
    <p class="brand">USGAME <span class="bdg">GTA VI</span></p>
    <p class="go">Taking you to the English edition…</p>
    <p class="alt">
      Nothing happening? <a href={TARGET}>Go to the English site →</a><br />
      中文读者：正在前往英文站 —— 也可以直接去 <a href="/zh/" hreflang="zh-Hans" lang="zh-Hans">简体中文站</a>。
    </p>
    <p class="foot">usgame.net · not affiliated with Rockstar Games</p>
  </main>
</body>
</html>
